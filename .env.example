# Export these variables in the shell that starts a run.
OPENAI_API_KEY=
TYPESAFE_API_KEY=
# Use a provider/model configured in Pi. See docs/reproduce.md.
JEVGPT_MODEL=openai/gpt-5.5
JEV_URL=https://api.typesafe.ai/v1/systemone
# Used only by the separate BrowseComp-Plus grader:
OPENAI_BASE_URL=https://api.openai.com/v1
JEVGPT_GRADER_MODEL=gpt-5.5
